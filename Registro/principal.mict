incluir("modulos/datos.mict")

ui.ventana("Registro Mictlán", 820, 520)
ui.minimo(660, 420)
ui.iniciar_columna(12)
    ui.etiqueta("Persona o lugar")
    ui.campo_texto(1, "")
    ui.etiqueta("Nota de la observación")
    ui.campo_texto(2, "")
    ui.iniciar_fila(12)
        ui.boton(3, "Guardar")
        ui.boton(4, "Recuperar")
        ui.boton(5, "Cerrar")
    ui.fin_contenedor()
    ui.etiqueta_id(6, "Tab cambia de campo. Enter guarda.")
ui.fin_contenedor()

funcion guardar_registro()
    nombre_reg = ui.texto(1)
    nota_reg = ui.texto(2)
    cantidad_reg = ui.longitud_texto(1)
    si cantidad_reg < 2
        visto_reg = ui.poner_texto(6, "Escribe un nombre de al menos dos caracteres.")
        visto_reg = ui.enfocar(1)
    sino
        estado_reg = registro_guardar("registro-v1.txt", nombre_reg, nota_reg)
        si estado_reg == 1
            visto_reg = ui.poner_texto(6, "Observación guardada.")
        osi estado_reg == 2
            visto_reg = ui.poner_texto(6, "Archivo actualizado. El disco no confirmó la escritura.")
        osi estado_reg == -2
            visto_reg = ui.poner_texto(6, "Revisa el nombre y la nota.")
        sino
            visto_reg = ui.poner_texto(6, "No se pudo escribir registro-v1.txt.")
        fin
    fin
fin

funcion recuperar_registro()
    datos_reg = registro_leer("registro-v1.txt")
    si tipo(datos_reg) == "lista"
        si ui.texto_valido(1, datos_reg[1]) && ui.texto_valido(2, datos_reg[2])
            visto_reg = ui.poner_texto(1, datos_reg[1])
            visto_reg = ui.poner_texto(2, datos_reg[2])
            visto_reg = ui.poner_texto(6, "Observación recuperada.")
        sino
            visto_reg = ui.poner_texto(6, "Texto inválido. Se conservan los campos.")
        fin
    osi tipo(datos_reg) == "nulo"
        visto_reg = ui.poner_texto(6, "Todavía no hay una observación guardada.")
    sino
        visto_reg = ui.poner_texto(6, "Archivo inválido. Se conservan los campos.")
    fin
fin

funcion cerrar_registro()
    ui.cerrar()
fin

ui.al_evento(1, 2, "guardar_registro")
ui.al_evento(2, 2, "guardar_registro")
ui.al_evento(3, 1, "guardar_registro")
ui.al_evento(4, 1, "recuperar_registro")
ui.al_evento(5, 1, "cerrar_registro")

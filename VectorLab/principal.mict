incluir("modulos/vectores.mict")
incluir("modulos/plano.mict")
incluir("modulos/sesion.mict")

ui.ventana("VectorLab Mictlán", 1080, 720)
ui.minimo(900, 620)
ui.iniciar_fila(16)
    ui.iniciar_columna(8)
        ui.etiqueta("Vector A y vector B · componentes")
        ui.iniciar_fila(8)
            ui.etiqueta("Ax")
            ui.campo_texto(1, "3")
            ui.etiqueta("Ay")
            ui.campo_texto(2, "4")
        ui.fin_contenedor()
        ui.iniciar_fila(8)
            ui.etiqueta("Bx")
            ui.campo_texto(3, "5")
            ui.etiqueta("By")
            ui.campo_texto(4, "12")
        ui.fin_contenedor()
        ui.iniciar_fila(8)
            ui.boton(5, "Calcular")
            ui.boton(7, "Guardar")
            ui.boton(8, "Cargar")
            ui.boton(6, "Salir")
        ui.fin_contenedor()
        ui.etiqueta_id(11, "|A| = —    |B| = —")
        ui.etiqueta_id(12, "A + B = —")
        ui.etiqueta_id(13, "A - B = —")
        ui.etiqueta_id(14, "A · B = —")
        ui.etiqueta_id(15, "Tab navega · Enter calcula")
    ui.fin_contenedor()
    ui.lienzo(20)
ui.fin_contenedor()

ultimo_ax_vl = ""
ultimo_ay_vl = ""
ultimo_bx_vl = ""
ultimo_by_vl = ""
escala_texto_vl = "Tab navega · Enter calcula"

funcion calcular()
    texto_ax_vl = ui.texto(1)
    texto_ay_vl = ui.texto(2)
    texto_bx_vl = ui.texto(3)
    texto_by_vl = ui.texto(4)
    cambio_vl = falso
    si texto_ax_vl != ultimo_ax_vl cambio_vl = verdadero fin
    si texto_ay_vl != ultimo_ay_vl cambio_vl = verdadero fin
    si texto_bx_vl != ultimo_bx_vl cambio_vl = verdadero fin
    si texto_by_vl != ultimo_by_vl cambio_vl = verdadero fin
    si cambio_vl
        ultimo_ax_vl = texto_ax_vl
        ultimo_ay_vl = texto_ay_vl
        ultimo_bx_vl = texto_bx_vl
        ultimo_by_vl = texto_by_vl
        actualizar_vl(texto_ax_vl, texto_ay_vl, texto_bx_vl, texto_by_vl)
    sino
        operacion_ok = ui.poner_texto(15, escala_texto_vl)
    fin
fin

funcion actualizar_vl(texto_ax, texto_ay, texto_bx, texto_by)
    componentes_vl = vectorlab_componentes(texto_ax, texto_ay, texto_bx, texto_by)
    si tipo(componentes_vl) != "lista"
        escala_texto_vl = "Revisa las componentes · rango ±1e100"
    sino
        calculos_vl = vectorlab_operar(componentes_vl[0], componentes_vl[1], componentes_vl[2], componentes_vl[3])
        operacion_ok = ui.poner_texto(11, "|A| = " .. calculos_vl.magnitud_a .. "    |B| = " .. calculos_vl.magnitud_b)
        operacion_ok = ui.poner_texto(12, "A + B = (" .. calculos_vl.suma[0] .. ", " .. calculos_vl.suma[1] .. ")")
        operacion_ok = ui.poner_texto(13, "A - B = (" .. calculos_vl.resta[0] .. ", " .. calculos_vl.resta[1] .. ")")
        operacion_ok = ui.poner_texto(14, "A · B = " .. calculos_vl.punto)
        escala_vista = vectorlab_plano(componentes_vl[0], componentes_vl[1], componentes_vl[2], componentes_vl[3], calculos_vl.magnitud_a, calculos_vl.magnitud_b)
        escala_texto_vl = "A azul · B naranja · escala ±" .. cadena.formato("%e", escala_vista)
    fin
    operacion_ok = ui.poner_texto(15, escala_texto_vl)
fin

funcion salir()
    ui.cerrar()
fin

funcion guardar()
    estado_vl = vectorlab_guardar("vectorlab-v1.txt", ui.texto(1), ui.texto(2), ui.texto(3), ui.texto(4))
    si estado_vl == 1
        operacion_ok = ui.poner_texto(15, "Sesión guardada en vectorlab-v1.txt")
    osi estado_vl == 2
        operacion_ok = ui.poner_texto(15, "Sesión guardada · sin confirmar el disco")
    osi estado_vl == -2
        operacion_ok = ui.poner_texto(15, "Revisa las componentes antes de guardar")
    sino
        operacion_ok = ui.poner_texto(15, "No se pudo guardar la sesión")
    fin
fin

funcion cargar()
    datos_vl = vectorlab_leer("vectorlab-v1.txt")
    si tipo(datos_vl) == "lista"
        operacion_ok = ui.poner_texto(1, datos_vl[1])
        operacion_ok = ui.poner_texto(2, datos_vl[2])
        operacion_ok = ui.poner_texto(3, datos_vl[3])
        operacion_ok = ui.poner_texto(4, datos_vl[4])
        calcular()
        operacion_ok = ui.poner_texto(15, "Sesión cargada · A azul · B naranja")
    osi tipo(datos_vl) == "nulo"
        operacion_ok = ui.poner_texto(15, "Todavía no hay una sesión guardada")
    sino
        operacion_ok = ui.poner_texto(15, "Sesión inválida · se conserva lo actual")
    fin
fin

ui.al_evento(1, 2, "calcular")
ui.al_evento(2, 2, "calcular")
ui.al_evento(3, 2, "calcular")
ui.al_evento(4, 2, "calcular")
ui.al_evento(5, 1, "calcular")
ui.al_evento(7, 1, "guardar")
ui.al_evento(8, 1, "cargar")
ui.al_evento(6, 1, "salir")
calcular()

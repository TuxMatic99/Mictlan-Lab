incluir("../modulos/vectores.mict")
incluir("../modulos/sesion.mict")
funcion exigir_sesion(estado, mensaje)
    si !estado error(mensaje) fin
fin
sesion_prueba = "vectorlab-prueba-v1.txt"
res = vectorlab_leer(sesion_prueba)
exigir_sesion(tipo(res) == "nulo", "El archivo de prueba debe estar ausente")
estado_archivo = vectorlab_guardar(sesion_prueba, "3", " 4 ", "-5.25e1", "0")
exigir_sesion(estado_archivo == 1, "Guardado completo")
res = vectorlab_leer(sesion_prueba)
exigir_sesion(tipo(res) == "lista", "Sesión legible")
exigir_sesion(res[1] == "3" && res[2] == " 4 " && res[3] == "-5.25e1" && res[4] == "0", "Valores recuperados")
estado_archivo = vectorlab_guardar(sesion_prueba, "NaN", "0", "0", "0")
exigir_sesion(estado_archivo == -2, "Guardado inválido rechazado")
res = vectorlab_leer(sesion_prueba)
exigir_sesion(res[3] == "-5.25e1", "El error conserva el último archivo")
estado_archivo = archivo.escribir_atomico(sesion_prueba, "VectorLab-v1\n3\n\n4\n5\n0\n")
exigir_sesion(estado_archivo == 1, "Preparación de caso inválido")
res = vectorlab_leer(sesion_prueba)
exigir_sesion(tipo(res) == "logico" && !res, "Se rechazan líneas vacías adicionales")
estado_archivo = archivo.escribir_atomico(sesion_prueba, "VectorLab-v2\n3\n4\n5\n0\n")
res = vectorlab_leer(sesion_prueba)
exigir_sesion(tipo(res) == "logico" && !res, "Se rechazan versiones desconocidas")
escribir("VectorLab: sesión comprobada")
